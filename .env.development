VITE_USE_EMULATOR=true
VITE_FIREBASE_PROJECT_ID=common-grounds-local
# Must be the emulator's default namespace (<project>-default-rtdb): that's the
# only one `firebase emulators:exec --export-on-exit` saves, so any other ns is
# wiped on every restart.
VITE_FIREBASE_DATABASE_URL=http://127.0.0.1:9000?ns=common-grounds-local-default-rtdb
